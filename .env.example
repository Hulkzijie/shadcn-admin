VITE_CLERK_PUBLISHABLE_KEY=

# 后端接口前缀：开发环境由 vite.config.ts 的 proxy 转发，生产环境由 Nginx / 网关转发
VITE_JAVA_API=/java-api
VITE_FASTAPI_API=/py-api

# 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# ===== 本地开发代理目标（vite dev server 转发地址）=====
# 本地开发默认指向本机；改为 http://<服务器公网IP>:8080 即可调用远程 Java 服务
VITE_JAVA_API_TARGET=http://127.0.0.1:8080
VITE_FASTAPI_API_TARGET=http://127.0.0.1:8000

# ===== RuoYi-Vue-Plus 后端配置 =====

# 接口加密开关（需与后端 api-decrypt.enabled 保持一致）
VITE_APP_ENCRYPT=true

# RSA 公钥：前端用于加密请求，对应后端 application.yml 的 api-decrypt.privateKey
VITE_APP_RSA_PUBLIC_KEY=MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ==

# RSA 私钥：前端用于解密响应，对应后端 application.yml 的 api-decrypt.publicKey
VITE_APP_RSA_PRIVATE_

# 客户端 ID（对应后端 sys_client 表）
VITE_APP_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e

# 默认租户 ID（多租户模式下需要，单租户可留空）
VITE_APP_TENANT_ID=000000
